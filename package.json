{
  "name": "vieneu-tts-app",
  "version": "0.1.0",
  "description": "Desktop app for VieNeu-TTS with a local REST API and MCP server",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "test:sidecar": "uv run --no-project --python 3.12 --with-requirements sidecar/requirements.lock --with pytest --with httpx python -m pytest sidecar/tests -q -p no:cacheprovider"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true
}
